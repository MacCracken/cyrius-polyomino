# input.cyr — keyboard input via Linux terminal raw mode. See ADR 0003.
#
# Non-canonical, non-blocking stdin (termios via ioctl, VMIN=0/VTIME=0).
# `input_poll()` reads the bytes available this frame and returns a bitmask
# of game actions. `poly_key_action()` and `input_decode()` are the pure
# decoders (unit-tested), the second handling arrow-key escape sequences
# (ESC [ A/B/C/D). Pattern mirrors cyrius-bb / cyrius-doom src/input.cyr.
#
# The raw-tty I/O is not unit-tested (CI has no controlling terminal) —
# only the pure decoders are. Requires `memcpy` from stdlib.
#
# Controls: a / left-arrow = move left, d / right = move right,
# s / down = soft drop, w / up = rotate CW, z = rotate CCW,
# space = hard drop, c = hold, m = mute, q / ESC / Ctrl-C = quit.

enum InputAction {
    ACT_LEFT = 1;
    ACT_RIGHT = 2;
    ACT_SOFT = 4;
    ACT_ROT_CW = 8;
    ACT_ROT_CCW = 16;
    ACT_QUIT = 32;
    ACT_HARD = 64;
    ACT_HOLD = 128;
    ACT_MUTE = 256;
}

enum TermConst {
    TCGETS = 0x5401;
    TCSETS = 0x5402;
}

enum InputConst {
    INPUT_READ_BYTES = 32;          # most bytes one poll reads
    INPUT_WAIT_GRACE_FRAMES = 45;   # frames a key wait ignores input for (~0.75 s)
}

var orig_termios[64];
var raw_active = 0;

# Single-byte key -> action bit. Pure; unit-tested.
fn poly_key_action(ch): i64 {
    if (ch == 97) { return ACT_LEFT; }      # 'a'
    if (ch == 100) { return ACT_RIGHT; }    # 'd'
    if (ch == 115) { return ACT_SOFT; }     # 's'
    if (ch == 32) { return ACT_HARD; }      # space
    if (ch == 119) { return ACT_ROT_CW; }   # 'w'
    if (ch == 122) { return ACT_ROT_CCW; }  # 'z'
    if (ch == 99) { return ACT_HOLD; }      # 'c'
    if (ch == 109) { return ACT_MUTE; }     # 'm'
    if (ch == 113) { return ACT_QUIT; }     # 'q'
    if (ch == 3) { return ACT_QUIT; }       # Ctrl-C (ISIG is off, so it arrives as a byte)
    return 0;
}

# Put the terminal into raw, non-blocking mode (saves the old settings).
# Returns -1 without changing modes if stdin is not a terminal (TCGETS
# fails) — the caller still runs; input_poll just reads whatever is there.
fn input_init(): i64 {
    if (syscall(16, 0, TCGETS, &orig_termios) < 0) { return 0 - 1; }
    var raw[64];
    memcpy(&raw, &orig_termios, 60);
    # c_lflag &= ~(ICANON|ECHO|ISIG) = ~(2|8|1) = ~11
    var lflag = load32(&raw + 12);
    lflag = lflag & (0 - 12);
    store32(&raw + 12, lflag);
    # c_iflag &= ~(IXON|ICRNL|BRKINT|INPCK|ISTRIP)
    var iflag = load32(&raw);
    iflag = iflag & (0 - 1331);
    store32(&raw, iflag);
    # c_cc[VMIN]=0 (non-blocking), c_cc[VTIME]=0. c_cc starts at byte 17
    # (after the four 4-byte flags + the 1-byte c_line); VTIME is index 5,
    # VMIN index 6 -> bytes 22 and 23. Getting VMIN wrong leaves read()
    # blocking (VMIN=1), so the loop only advances on a keypress.
    store8(&raw + 23, 0); # c_cc[VMIN]
    store8(&raw + 22, 0); # c_cc[VTIME]
    if (syscall(16, 0, TCSETS, &raw) < 0) { return 0 - 1; }
    raw_active = 1;
    return 0;
}

# Whether input_init put a terminal in raw mode (1), or there is none (0).
fn input_is_raw(): i64 { return raw_active; }

# Restore the terminal modes input_init saved. No-op if raw mode is not active.
fn input_shutdown(): i64 {
    if (raw_active == 1) {
        syscall(16, 0, TCSETS, &orig_termios);
        raw_active = 0;
    }
    return 0;
}

# Decode `n` raw tty bytes into the OR of their action bits. Pure. Arrow keys:
# ESC [ A = up (rotate CW), B = down (soft), C = right, D = left. A lone ESC
# is the quit key, but a read can end partway through an arrow sequence, so
# that must not quit: an ESC [ at the end of the bytes is ignored, as is a
# final ESC when the read filled the buffer and more is waiting. The rest of
# a split sequence arrives next poll as bytes that map to no action.
fn input_decode(buf, n): i64 {
    var act = 0;
    var pos = 0;
    var ch = 0;
    var s2 = 0;
    while (pos < n) {
        ch = load8(buf + pos);
        if (ch != 27) {
            act = act | poly_key_action(ch);
            pos = pos + 1;
            continue;
        }
        if (pos + 1 == n) {
            if (n < INPUT_READ_BYTES) { act = act | ACT_QUIT; }
            return act;
        }
        if (load8(buf + pos + 1) != 91) {
            act = act | ACT_QUIT;
            pos = pos + 1;
            continue;
        }
        if (pos + 2 == n) { return act; }
        s2 = load8(buf + pos + 2);
        if (s2 == 65) { act = act | ACT_ROT_CW; }
        if (s2 == 66) { act = act | ACT_SOFT; }
        if (s2 == 67) { act = act | ACT_RIGHT; }
        if (s2 == 68) { act = act | ACT_LEFT; }
        pos = pos + 3;
    }
    return act;
}

# Read all bytes available this frame; return the OR of action bits.
# Non-blocking: returns 0 immediately when nothing is waiting.
fn input_poll(): i64 {
    var buf[INPUT_READ_BYTES];
    var n = syscall(0, 0, &buf, INPUT_READ_BYTES);
    if (n <= 0) { return 0; }
    return input_decode(&buf, n);
}

# Has a wait for a key finished? `frame` is how many frames have been waited
# and `act` the keys seen on the latest. Keys inside the grace window are
# ignored, so a key still held from play cannot end the wait at once. Pure.
fn input_wait_done(frame, act): i64 {
    if (frame < INPUT_WAIT_GRACE_FRAMES) { return 0; }
    if (act == 0) { return 0; }
    return 1;
}

# Is command-line text `s` a plain decimal integer of at most 18 digits, with
# a leading '-' allowed when `allow_neg` is 1? atoi reads anything else as a
# number anyway (non-numeric text as 0) and wraps past 64 bits. Pure.
fn input_arg_is_int(s, allow_neg): i64 {
    var i = 0;
    if (allow_neg == 1) {
        if (load8(s) == 45) { i = 1; }
    }
    var start = i;
    var c = load8(s + i);
    while (c != 0) {
        if (c < 48) { return 0; }
        if (c > 57) { return 0; }
        i = i + 1;
        c = load8(s + i);
    }
    if (i == start) { return 0; }
    if ((i - start) > 18) { return 0; }
    return 1;
}
