# synth.cyr — square-wave tone synthesis. See ADR 0002 (original assets), 0003.
#
# Pure integer PCM generation: renders era-spirit square-wave "blips" into a
# frame buffer. No sampled audio (ADR 0002), no floating point, no device I/O
# — so it is deterministic and fully headless-testable (assert a sample). The
# device routing lives in audio.cyr (vani), the way present.cyr fronts the
# framebuffer.
#
# Format: the playback device's own — 48 kHz, signed 16-bit little-endian
# (S16_LE), interleaved stereo with L == R. A raw ALSA hw PCM does no format
# or rate conversion, and the target codec (card 1, the ALC897) takes only
# 16/32-bit stereo at 44.1 kHz and up: it rejects the 11025 Hz 8-bit mono
# this module rendered through 0.5.4 with -EINVAL (probed on the hardware).
# Silence is 0; a sample swings +/-amplitude around it. A note is one square
# wave at a given frequency with a linear amplitude decay across its length,
# so it fades rather than clicking off — the classic chiptone envelope.
#
# Offsets and counts are in FRAMES (one sample per channel); frame f lives at
# byte buf + f * SYNTH_FRAME_BYTES.
#
# Self-contained — only store16 + arithmetic. Include before audio.cyr.

enum SynthConst {
    SYNTH_RATE = 48000;         # frames per second — every HD-Audio codec supports 48 kHz
    SYNTH_CHANNELS = 2;         # interleaved stereo, L == R
    SYNTH_FRAME_BYTES = 4;      # SYNTH_CHANNELS x 16-bit
    SYNTH_AMP = 10240;          # default amplitude (of 32767) — 40/128 of full scale, as the 8-bit cut had
}

# Frames needed for `ms` milliseconds at SYNTH_RATE.
fn synth_frames_for_ms(ms): i64 { return (SYNTH_RATE * ms) / 1000; }

# Store signed sample `s` in both channels of frame `f`. store16 keeps the low
# 16 bits, so a negative sample lands as its two's-complement S16_LE encoding.
fn synth_frame(buf, f, s): i64 {
    var p = buf + (f * SYNTH_FRAME_BYTES);
    store16(p, s);
    store16(p + 2, s);
    return 0;
}

# Render `n` frames of a square wave at `freq` Hz, amplitude `amp`, into
# `buf` starting at frame `off`. Returns the next write cursor (off + n).
# freq <= 0 renders a rest (silence). The amplitude decays linearly from `amp`
# to ~0 across the n frames (fade-out, no click).
fn synth_square(buf, off, n, freq, amp): i64 {
    var i = 0;
    if (freq <= 0) {
        while (i < n) {
            synth_frame(buf, off + i, 0);
            i = i + 1;
        }
        return off + n;
    }
    var period = SYNTH_RATE / freq;     # frames per full cycle
    if (period < 2) { period = 2; }
    var half = period / 2;
    var phase = 0;
    var a = 0;
    while (i < n) {
        a = (amp * (n - i)) / n;        # linear decay envelope
        if (phase < half) {
            synth_frame(buf, off + i, a);
        } else {
            synth_frame(buf, off + i, 0 - a);
        }
        phase = phase + 1;
        if (phase >= period) { phase = 0; }
        i = i + 1;
    }
    return off + n;
}
